manifest {
    name = 'Gitsiba/ATAC-seq'
    description = 'Paired-end ATAC-seq processing starter workflow'
    author = 'Siba Pattanaik'
    version = '0.1.0'
    nextflowVersion = '>=24.04.0'
}

params {
    samplesheet = null
    reference_fasta = null
    genome_size = 'hs'
    outdir = 'results'
}

process {
    errorStrategy = 'terminate'
    maxRetries = 1
    withName: FASTQC_RAW { cpus = 2; memory = '2 GB' }
    withName: TRIM_READS { cpus = 2; memory = '4 GB' }
    withName: FASTQC_TRIMMED { cpus = 2; memory = '2 GB' }
    withName: BUILD_INDEX { cpus = 4; memory = '8 GB' }
    withName: ALIGN_AND_DEDUP { cpus = 4; memory = '8 GB' }
    withName: CALL_PEAKS { cpus = 2; memory = '4 GB' }
    withName: MULTIQC { cpus = 1; memory = '2 GB' }
}

profiles {
    conda {
        conda.enabled = true
        docker.enabled = false
    }
    docker {
        docker.enabled = true
        conda.enabled = false
    }
    test {
        process.executor = 'local'
        process.cpus = 2
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
