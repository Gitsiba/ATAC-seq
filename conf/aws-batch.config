/*
 * AWS Batch execution profile.
 *
 * Supply the queue, S3 work directory and ECR image at runtime.
 * Never put AWS access keys, secret keys, or private data in this file.
 */
params.aws_region = params.aws_region ?: 'ap-south-1'
params.aws_batch_queue = params.aws_batch_queue ?: null
params.aws_workdir = params.aws_workdir ?: null
params.container_image = params.container_image ?: null

if (!params.aws_batch_queue) {
    error "Set --aws_batch_queue to the name or ARN of an existing AWS Batch job queue"
}
if (!params.aws_workdir || !params.aws_workdir.startsWith('s3://')) {
    error "Set --aws_workdir to an S3 URI, for example s3://YOUR-BUCKET/atacseq/work"
}
if (!params.container_image) {
    error "Set --container_image to the ATAC-seq tools image in Amazon ECR"
}

aws {
    region = params.aws_region
}

workDir = params.aws_workdir

process {
    executor = 'awsbatch'
    queue = params.aws_batch_queue
    container = params.container_image
    errorStrategy = 'terminate'
    maxRetries = 1
}
